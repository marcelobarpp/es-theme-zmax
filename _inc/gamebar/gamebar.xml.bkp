<maxSize>0.02 0.03</maxSize>
<color>999999</color>
<zIndex>998</zIndex>
</image>

<image name="md_manual">
<origin>0.5 0.5</origin>
<pos>0.465 0.021</pos>
<path>./_inc/gamebar/book.png</path>
<maxSize>0.02 0.03</maxSize>
<color>ffffff</color>
<zIndex>999</zIndex>
</image>


<image name="md_nosavestate" extra="true">
<origin>0.5 0.5</origin>
<path>./_inc/gamebar/SaveState.png</path>
<pos>0.525 0.021</pos>
<maxSize>0.02 0.03</maxSize>
<color>999999</color>
<zIndex>998</zIndex>
</image>

<image name="md_savestate">
<origin>0.5 0.5</origin>
<path>./_inc/gamebar/SaveState.png</path>
<pos>0.525 0.021</pos>
<maxSize>0.02 0.03</maxSize>
<color>ffffff</color>
<zIndex>999</zIndex>
</image>


	
<image name="md_notkidgame" extra="true">
<origin>0.5 0.5</origin>
<pos>0.495 0.021</pos>
<path>./_inc/gamebar/kid.png</path>
<maxSize>0.02 0.03</maxSize>
<linearSmooth>true</linearSmooth>
<color>999999</color>
<zIndex>998</zIndex>
</image>
	
<image name="md_kidgame"> 
<origin>0.5 0.5</origin>
<pos>0.495 0.021</pos>
<path>./_inc/gamebar/kid.png</path>
<maxSize>0.02 0.03</maxSize>
<color>ffffff</color>
<zIndex>999</zIndex>
<linearSmooth>true</linearSmooth>
</image>


<control name="md_notkidgame,md_kidgame,md_nosavestate,md_savestate,md_savestateExtra,md_nomanual,md_manual,md_cheevos,md_notcheevos,md_cheevosExtra,md_hidden,md_hiddenExtra,gamebar">
<storyboard event="open">
<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
<animation property="offsetY" to="-0.15" duration="600" mode="easeIn" begin="3000"/>
</storyboard>
<storyboard event="activateNext">
<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
<animation property="offsetY" to="-0.15" duration="600" mode="easeIn" begin="3000"/>
</storyboard>
<storyboard event="activatePrev">
<animation property="opacity" from="1" to="1" duration="1" mode="linear"/>
<animation property="offsetY" to="-0.15" duration="600" mode="easeIn" begin="3000"/>
</storyboard>
<storyboard event="deactivateNext">
<animation property="opacity" to="0" duration="1" mode="easeOut"/>
</storyboard>
<storyboard event="deactivatePrev">
<animation property="opacity" to="0" duration="1" mode="easeOut"/>
</storyboard>
</control>
</view>






		<image name="md_flag">
			<origin>0 0.5</origin>
