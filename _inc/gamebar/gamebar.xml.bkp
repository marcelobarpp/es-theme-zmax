<theme>
<formatVersion>7</formatVersion>

<view name="detailed,video,grid,gamecarousel"> <!-- DELETE VIEW YOU DON'T HAVE IN YOUR THEME -->




<image name="gamebar" extra="true">
<linearSmooth>true</linearSmooth>
<path>./_inc/gamebar/gamebar.png</path>
<origin>0.5 0</origin>
<pos>0.5 0</pos>
<zIndex>996</zIndex>
<size>1 1</size>
</image>



<image name="md_hiddenExtra" extra="true">
<origin>0.5 0.5</origin>
<pos>0.58 0.021</pos>
<path>./_inc/gamebar/hidden.png</path>
<maxSize>0.02 0.03</maxSize>
<color>999999</color>
<zIndex>998</zIndex>
</image>

<image name="md_hidden">
<origin>0.5 0.5</origin>
<pos>0.58 0.021</pos>
<path>./_inc/gamebar/hidden.png</path>
<maxSize>0.02 0.03</maxSize>
<color>ffffff</color>
<zIndex>999</zIndex>
</image>



